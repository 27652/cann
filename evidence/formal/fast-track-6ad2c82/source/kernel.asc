// Same finite-input contract as ExactQuant. The hint may be arbitrarily bad:
// integer product/remainder checks certify it, or a 7-step fallback is used.
__aicore__ inline uint32_t FastExactQuantPrepared(uint32_t a, uint32_t mb,
                                                int32_t eb, uint32_t hint)
{
    if ((a & 0x80000000U) || (a & 0x7fffffffU) == 0U) return 0U;
    if (mb == 0U) return 0U;
    int32_t ea = static_cast<int32_t>((a >> 23) & 255U);
    if (ea == 255) return 0U;
    uint32_t ma = a & 0x7fffffU;
    if (ea) ma |= 0x800000U;
    else { ea = 1; while (ma < 0x800000U) { ma <<= 1; --ea; } }
    int32_t exponent = ea - eb;
    if (ma < mb) { ma <<= 1; --exponent; }
    if (exponent < -1) return 0U;
    if (exponent >= 7) return 127U;

    // Exact positive rational A / B in [0.5,128). A < 2^31, B < 2^25.
    const uint32_t A = exponent < 0 ? ma : ma << exponent;
    const uint32_t B = exponent < 0 ? mb << 1 : mb;
    uint32_t n = hint < 128U ? hint : 127U;
    if (exponent < 0) n = 0U;
    uint32_t product = n * B;
    if (product > A && n != 0U) { --n; product -= B; }
    else if (product <= A && A - product >= B && n < 127U) { ++n; product += B; }
    if (product > A || A - product >= B) {
        // No error bound on the approximate division is required.
        n = 0U;
        uint32_t remainder = A;
        for (int32_t bit = 6; bit >= 0; --bit) {
            const uint32_t step = B << bit;
            if (remainder >= step) { remainder -= step; n |= 1U << bit; }
        }
        product = A - remainder;
    }

    const uint32_t twiceRemainder = (A - product) << 1;
    // The half-integer h=n+0.5 is exactly representable and has even FP32
    // significand. The FP32 rounding interval extends half an ULP around h.
    // Compare integer distances to that interval without constructing q.
    const uint32_t band = B >> static_cast<uint32_t>(23 - exponent);
    bool up;
    if (n & 1U) up = twiceRemainder >= B || B - twiceRemainder <= band;
    else up = twiceRemainder > B && twiceRemainder - B > band;
    const uint32_t result = n + static_cast<uint32_t>(up);
    return result > 127U ? 127U : result;
}

__aicore__ inline uint32_t FastExactQuantBits(uint32_t a, uint32_t b, uint32_t hint)
{
    if ((b & 0x80000000U) || (b & 0x7fffffffU) == 0U) return 0U;
    int32_t eb = static_cast<int32_t>((b >> 23) & 255U);
    if (eb == 255) return 0U;
    uint32_t mb = b & 0x7fffffU;
    if (eb) mb |= 0x800000U;
    else { eb = 1; while (mb < 0x800000U) { mb <<= 1; --eb; } }
    return FastExactQuantPrepared(a, mb, eb, hint);
}

__aicore__ inline uint32_t FastQuantHintBits(uint32_t bits)
{
    // Decode floor(q), clipped to [0,127], with integer shifts only.
    // Negative/non-finite hints are discarded; subnormals and q<1 yield 0.
    if ((bits & 0x80000000U) || bits >= 0x7f800000U) return 0U;
    if (bits >= 0x43000000U) return 127U; // q >= 128
    if (bits < 0x3f800000U) return 0U; // q < 1
    // Exponent field is 127..133, so the shift is safely 23..17.
    return ((bits & 0x7fffffU) | 0x800000U) >> (150U - (bits >> 23));
}

__aicore__ inline uint32_t FastExactQuant(float a, float b, float approximate)
{
    union Bits { float f; uint32_t u; } aa, bb, qq;
    aa.f = a; bb.f = b; qq.f = approximate;
    return FastExactQuantBits(aa.u, bb.u, FastQuantHintBits(qq.u));
}
// For finite nonnegative a and finite positive b, compute
// clamp(RNE_integer(RNE_binary32(a / b)), 0, 127).
// Only 32-bit shifts/subtractions are needed; no floating division, epsilon,
// double precision or target-specific reciprocal is used.
__aicore__ inline uint32_t ExactQuantBits(uint32_t a, uint32_t b)
{
    if ((a & 0x80000000U) || (a & 0x7fffffffU) == 0U) return 0U;
    if ((b & 0x80000000U) || (b & 0x7fffffffU) == 0U) return 0U;
    int32_t ea = static_cast<int32_t>((a >> 23) & 255U);
    int32_t eb = static_cast<int32_t>((b >> 23) & 255U);
    if (ea == 255 || eb == 255) return 0U; // non-finite outside helper domain
    uint32_t ma = a & 0x7fffffU;
    uint32_t mb = b & 0x7fffffU;
    if (ea) ma |= 0x800000U;
    else { ea = 1; while (ma < 0x800000U) { ma <<= 1; --ea; } }
    if (eb) mb |= 0x800000U;
    else { eb = 1; while (mb < 0x800000U) { mb <<= 1; --eb; } }
    int32_t exponent = ea - eb;
    if (ma < mb) { ma <<= 1; --exponent; }
    if (exponent < -1) return 0U;
    if (exponent >= 7) return 127U;

    uint32_t mantissa = 0x800000U;
    uint32_t remainder = ma - mb;
    for (int32_t bit = 22; bit >= 0; --bit) {
        remainder <<= 1;
        if (remainder >= mb) { remainder -= mb; mantissa |= 1U << bit; }
    }
    const uint32_t twice = remainder << 1;
    if (twice > mb || (twice == mb && (mantissa & 1U))) ++mantissa;
    if (mantissa == 0x1000000U) { mantissa >>= 1; ++exponent; }
    if (exponent >= 7) return 127U;

    const uint32_t shift = static_cast<uint32_t>(23 - exponent);
    uint32_t integer = mantissa >> shift;
    const uint32_t tail = mantissa & ((1U << shift) - 1U);
    const uint32_t half = 1U << (shift - 1U);
    if (tail > half || (tail == half && (integer & 1U))) ++integer;
    return integer > 127U ? 127U : integer;
}

__aicore__ inline uint32_t ExactQuant(float a, float b)
{
    union Bits { float f; uint32_t u; } numerator, denominator;
    numerator.f = a;
    denominator.f = b;
    return ExactQuantBits(numerator.u, denominator.u);
}

namespace QuantMatmulReluQuant {

using CubeTiling = AscendC::tiling::TCubeTiling;

// 25 bytes per lane plus 64 bytes of reduction/scale output and 512 B mask.
// Keep full rows up to 4096 columns resident within the dav-2201 UB budget.
constexpr uint32_t VECTOR_TILE_N = 4096;
constexpr uint32_t CONVERT_TILE_ELEMENTS = 1024;
constexpr uint32_t CUBE_ROW_JOB_M = 128;
constexpr uint32_t FLOAT_ALIGN_ELEMENTS = 8; // one 32-byte data block
constexpr uint32_t INT8_ALIGN_ELEMENTS = 32; // one 32-byte data block
// One chunk is bounded by 2^16 products.  Even the largest positive INT8
// product (16384) then sums to only 2^30, so the Cube accumulator cannot
// saturate inside a chunk.  Later chunks are added to GM as INT32, preserving
// the modulo-2^32 behavior of NumPy's INT32 matmul when the complete dot
// product crosses an INT32 boundary.
constexpr uint32_t SAFE_ACCUM_K = 65536;
// The distributed Python golden casts both INT8 operands to FLOAT32 *before*
// np.matmul.  Starting here an exact INT32 dot product can no longer reproduce
// the FLOAT32 accumulator's rounding, so large-K cases use a genuine FP32
// Matmul path.  Smaller shapes retain the already judge-proven INT8 path.
constexpr uint32_t FP32_MATMUL_K_THRESHOLD = 65536;
constexpr uint32_t FIRST_POSSIBLE_INT32_OVERFLOW_K = 131072;
// ND operands whose inner axis reaches 65536 require the Matmul API's guarded
// cyclic GM-to-L1 move-in path.  Without intrinsicsCheck, the hardware stride
// field wraps at this boundary and the Matmul result remains zero.
constexpr ::MatmulConfig MATMUL_CONFIG = ::GetMDLConfig(true);

inline uint32_t CeilDivHost(uint32_t value, uint32_t divisor)
{
    return (value + divisor - 1U) / divisor;
}

inline uint32_t AlignUpHost(uint32_t value, uint32_t alignment)
{
    return CeilDivHost(value, alignment) * alignment;
}

__aicore__ inline uint32_t AlignUpDevice(uint32_t value, uint32_t alignment)
{
    return ((value + alignment - 1U) / alignment) * alignment;
}

/*
 * Cube stage
 * ----------
 * Each AIV client submits one contiguous range of M and the complete N
 * dimension to its paired AIC through the Matmul high-level API.
 * Keeping N unsplit is intentional: both vector cores paired with a cube core
 * can then finish complete rows without a cross-cube row-max reduction.
 */
class CubeStage {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR mmWorkspace,
                                const CubeTiling &tilingData)
    {
        tiling = tilingData;
        x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                                 static_cast<uint64_t>(tiling.M) * tiling.Ka);
        // B is physically [N, K] and is consumed as the transpose [K, N].
        x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                                 static_cast<uint64_t>(tiling.N) * tiling.Kb);
        mmGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(mmWorkspace),
                                 static_cast<uint64_t>(tiling.M) * tiling.N);

        const uint32_t cubeIdx = AscendC::GetBlockIdx();
        const uint32_t rowOffset = cubeIdx * tiling.singleCoreM;
        const uint32_t remainingRows = tiling.M - rowOffset;
        validRows = remainingRows < tiling.singleCoreM ? remainingRows : tiling.singleCoreM;
        x1Global = x1Global[static_cast<uint64_t>(rowOffset) * tiling.Ka];
        mmGlobal = mmGlobal[static_cast<uint64_t>(rowOffset) * tiling.N];
    }

    __aicore__ inline void Process()
    {
        matmul.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
        if (tiling.Ka < FIRST_POSSIBLE_INT32_OVERFLOW_K) {
            // A large global M can make singleCoreM much larger than baseM
            // after all physical Cube cores are occupied.  Submit bounded
            // row jobs instead of one oversized tail job; all jobs still run
            // inside this single launched MIX kernel.
            for (uint32_t localRow = 0; localRow < validRows;
                 localRow += CUBE_ROW_JOB_M) {
                const uint32_t remainingRows = validRows - localRow;
                const uint32_t jobRows = remainingRows < CUBE_ROW_JOB_M
                    ? remainingRows : CUBE_ROW_JOB_M;
                matmul.SetTensorA(
                    x1Global[static_cast<uint64_t>(localRow) * tiling.Ka], false);
                matmul.SetTensorB(x2Global, true);
                matmul.SetTail(jobRows, tiling.N);
                matmul.template IterateAll<true>(
                    mmGlobal[static_cast<uint64_t>(localRow) * tiling.N]);
            }
            matmul.End();
            return;
        }

        for (uint32_t localRow = 0; localRow < validRows;
             localRow += CUBE_ROW_JOB_M) {
            const uint32_t remainingRows = validRows - localRow;
            const uint32_t jobRows = remainingRows < CUBE_ROW_JOB_M
                ? remainingRows : CUBE_ROW_JOB_M;
            const uint64_t aRowOffset =
                static_cast<uint64_t>(localRow) * tiling.Ka;
            const uint64_t cRowOffset =
                static_cast<uint64_t>(localRow) * tiling.N;

            uint32_t kOffset = 0;
            bool firstChunk = true;
            while (kOffset < tiling.Ka) {
                const uint32_t remainingK = tiling.Ka - kOffset;
                const uint32_t chunkK =
                    remainingK < SAFE_ACCUM_K ? remainingK : SAFE_ACCUM_K;

                matmul.SetTensorA(x1Global[aRowOffset + kOffset], false);
                matmul.SetTensorB(x2Global[kOffset], true);
                matmul.SetTail(jobRows, tiling.N, chunkK);
                // The first chunk initializes GM. Subsequent safe partial
                // sums use modulo-2^32 INT32 atomic addition.
                const uint8_t atomicAdd = firstChunk ? 0U : 1U;
                matmul.template IterateAll<true>(mmGlobal[cRowOffset], atomicAdd);
                firstChunk = false;
                kOffset += chunkK;
            }
        }
        matmul.End();
    }

    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, true>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>,
        MATMUL_CONFIG>
        matmul;
    CubeTiling tiling;
    uint32_t validRows = 0;

private:
    AscendC::GlobalTensor<int8_t> x1Global;
    AscendC::GlobalTensor<int8_t> x2Global;
    AscendC::GlobalTensor<int32_t> mmGlobal;
};

#if defined(SPLIT_CORE_CUBE)
/*
 * Direct FP32 Cube stage used only by the AIC half of a MIX kernel.
 * The regular small-K path intentionally stays on the KFC client/server API.
 */
class FloatCubeStage {
public:
    __aicore__ inline void Init(GM_ADDR x1Float, GM_ADDR x2Float,
                                GM_ADDR mmFloat, const CubeTiling &tilingData,
                                AscendC::TPipe *pipe)
    {
        tiling = tilingData;
        x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x1Float),
                                 static_cast<uint64_t>(tiling.M) * tiling.Ka);
        x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x2Float),
                                 static_cast<uint64_t>(tiling.N) * tiling.Kb);
        mmGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(mmFloat),
                                 static_cast<uint64_t>(tiling.M) * tiling.N);

        const uint32_t coreIdx = AscendC::GetBlockIdx();
        const uint32_t rowOffset = coreIdx * tiling.singleCoreM;
        const uint32_t remainingRows = tiling.M - rowOffset;
        validRows = remainingRows < tiling.singleCoreM ? remainingRows : tiling.singleCoreM;
        x1Global = x1Global[static_cast<uint64_t>(rowOffset) * tiling.Ka];
        mmGlobal = mmGlobal[static_cast<uint64_t>(rowOffset) * tiling.N];

        matmul.Init(&tiling, pipe);
        matmul.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    }

    __aicore__ inline void Process()
    {
        constexpr uint32_t VECTOR_TO_CUBE_EVENT = 4;
        constexpr uint32_t CUBE_TO_VECTOR_EVENT = 5;
        AscendC::WaitEvent(VECTOR_TO_CUBE_EVENT);
        matmul.SetTensorA(x1Global, false);
        matmul.SetTensorB(x2Global, true);
        matmul.SetTail(validRows, tiling.N);
        matmul.template IterateAll<true>(mmGlobal);
        matmul.End();
        AscendC::NotifyEvent<PIPE_FIX>(CUBE_TO_VECTOR_EVENT);
    }

private:
    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND,
                                     float, false>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND,
                                     float, true>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND,
                                     float>;
    AscendC::MatmulImpl<AType, BType, CType, CType, MATMUL_CONFIG> matmul;
    CubeTiling tiling;
    uint32_t validRows = 0;
    AscendC::GlobalTensor<float> x1Global;
    AscendC::GlobalTensor<float> x2Global;
    AscendC::GlobalTensor<float> mmGlobal;
};
#endif

#if defined(SPLIT_CORE_VEC)
/* Convert both complete INT8 operands to exact FP32 values in parallel. */
class FloatInputConverter {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR x1Float,
                                GM_ADDR x2Float, const CubeTiling &tilingData,
                                AscendC::TPipe *pipe)
    {
        tiling = tilingData;
        const uint64_t x1Count = static_cast<uint64_t>(tiling.M) * tiling.Ka;
        const uint64_t x2Count = static_cast<uint64_t>(tiling.N) * tiling.Kb;
        x1Input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), x1Count);
        x2Input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), x2Count);
        x1Output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x1Float), x1Count);
        x2Output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x2Float), x2Count);

        pipe->InitBuffer(inputQueue, 1, CONVERT_TILE_ELEMENTS * sizeof(int8_t));
        pipe->InitBuffer(halfBuffer, CONVERT_TILE_ELEMENTS * sizeof(half));
        pipe->InitBuffer(outputQueue, 1, CONVERT_TILE_ELEMENTS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        ConvertTensor(x1Input, x1Output,
                      static_cast<uint64_t>(tiling.M) * tiling.Ka);
        ConvertTensor(x2Input, x2Output,
                      static_cast<uint64_t>(tiling.N) * tiling.Kb);
        AscendC::SyncAll();
        AscendC::NotifyEvent<PIPE_MTE3>(4);
    }

private:
    __aicore__ inline void ConvertTensor(AscendC::GlobalTensor<int8_t> input,
                                         AscendC::GlobalTensor<float> output,
                                         uint64_t totalElements)
    {
        const uint64_t first =
            static_cast<uint64_t>(AscendC::GetBlockIdx()) * CONVERT_TILE_ELEMENTS;
        const uint64_t stride =
            static_cast<uint64_t>(tiling.usedCoreNum) * CONVERT_TILE_ELEMENTS;
        for (uint64_t offset = first; offset < totalElements; offset += stride) {
            const uint64_t remaining = totalElements - offset;
            const uint32_t validCount = static_cast<uint32_t>(
                remaining < CONVERT_TILE_ELEMENTS ? remaining : CONVERT_TILE_ELEMENTS);
            const uint32_t alignedCount =
                AlignUpDevice(validCount, INT8_ALIGN_ELEMENTS);

            AscendC::LocalTensor<int8_t> inputLocal = inputQueue.AllocTensor<int8_t>();
            if (validCount == alignedCount) {
                AscendC::DataCopy(inputLocal, input[offset], alignedCount);
            } else {
                const uint8_t rightPadding =
                    static_cast<uint8_t>(alignedCount - validCount);
                AscendC::DataCopyExtParams copy = {
                    1, validCount * static_cast<uint32_t>(sizeof(int8_t)), 0, 0, 0};
                AscendC::DataCopyPadExtParams<int8_t> pad = {
                    true, 0, rightPadding, static_cast<int8_t>(0)};
                AscendC::DataCopyPad(inputLocal, input[offset], copy, pad);
            }
            inputQueue.EnQue(inputLocal);
            inputLocal = inputQueue.DeQue<int8_t>();

            AscendC::LocalTensor<half> halfLocal = halfBuffer.Get<half>();
            AscendC::LocalTensor<float> outputLocal = outputQueue.AllocTensor<float>();
            AscendC::Cast(halfLocal, inputLocal, AscendC::RoundMode::CAST_NONE,
                          alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(outputLocal, halfLocal, AscendC::RoundMode::CAST_NONE,
                          alignedCount);
            inputQueue.FreeTensor(inputLocal);

            outputQueue.EnQue(outputLocal);
            outputLocal = outputQueue.DeQue<float>();
            AscendC::DataCopyExtParams outputCopy = {
                1, validCount * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPad(output[offset], outputLocal, outputCopy);
            outputQueue.FreeTensor(outputLocal);
        }
    }

    CubeTiling tiling;
    AscendC::GlobalTensor<int8_t> x1Input;
    AscendC::GlobalTensor<int8_t> x2Input;
    AscendC::GlobalTensor<float> x1Output;
    AscendC::GlobalTensor<float> x2Output;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inputQueue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> halfBuffer;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outputQueue;
};
#endif

/*
 * Vector stage
 * ------------
 * The first pass computes the row maximum. The second pass performs dynamic
 * quantization. Only the int32 matmul result lives in GM; fp32 activation
 * tiles stay in UB. CAST_RINT implements round-half-to-even in int32; two
 * saturating narrowing casts then produce the final int8 values on A3.
 */
class VectorStage {
public:
    __aicore__ inline void Init(GM_ADDR mmWorkspace, GM_ADDR x1Scale, GM_ADDR x2Scale,
                                GM_ADDR y, GM_ADDR yScale, const CubeTiling &tilingData,
                                AscendC::TPipe *pipe, bool useFloatMatmul = false)
    {
        tiling = tilingData;
        floatMatmul = useFloatMatmul;
        const uint64_t elementCount = static_cast<uint64_t>(tiling.M) * tiling.N;
        mmGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(mmWorkspace), elementCount);
        mmFloatGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(mmWorkspace), elementCount);
        x1ScaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x1Scale), tiling.M);
        x2ScaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x2Scale), tiling.N);
        yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(y), elementCount);
        yScaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(yScale), tiling.M);

        pipe->InitBuffer(mmQueue, 1, VECTOR_TILE_N * sizeof(int32_t));
        pipe->InitBuffer(channelScaleQueue, 1, VECTOR_TILE_N * sizeof(float));
        pipe->InitBuffer(fpBuffer, VECTOR_TILE_N * sizeof(float));
        pipe->InitBuffer(divisorBuffer, VECTOR_TILE_N * sizeof(float));
        pipe->InitBuffer(reduceWorkBuffer, VECTOR_TILE_N * sizeof(float));
        pipe->InitBuffer(reduceOutBuffer, FLOAT_ALIGN_ELEMENTS * sizeof(float));
        // dav-2201 has no direct fp32 -> int8 Cast.  Round fp32 to int16,
        // convert the small integral range exactly to half, then use the
        // supported half -> int8 saturating Cast.
        pipe->InitBuffer(quantInt16Buffer, VECTOR_TILE_N * sizeof(int16_t));
        pipe->InitBuffer(quantHalfBuffer, VECTOR_TILE_N * sizeof(half));
        pipe->InitBuffer(quantQueue, 1, VECTOR_TILE_N * sizeof(int8_t));
        pipe->InitBuffer(yScaleQueue, 1, FLOAT_ALIGN_ELEMENTS * sizeof(float));
        pipe->InitBuffer(boundaryMaskBuffer, VECTOR_TILE_N / 8);
#if QUANT_CACHE_TWO_TILES
        pipe->InitBuffer(firstTileBuffer, VECTOR_TILE_N * sizeof(float));
#endif
    }

    __aicore__ inline void Process()
    {
        // In a 1:1 MIX kernel, AIV block ids directly identify row groups.
        const uint32_t cubeIdx =
            static_cast<uint32_t>(AscendC::GetBlockIdx());
        if (cubeIdx >= tiling.usedCoreNum) {
            return;
        }
        const uint32_t firstRow = cubeIdx * tiling.singleCoreM;
        uint32_t rowEnd = firstRow + tiling.singleCoreM;
        if (rowEnd > tiling.M) {
            rowEnd = tiling.M;
        }

        if (QUANT_SCALE_RESIDENT && tiling.N <= VECTOR_TILE_N && firstRow < rowEnd) {
            const uint32_t aligned = AlignUpDevice(tiling.N, FLOAT_ALIGN_ELEMENTS);
            residentScale = channelScaleQueue.AllocTensor<float>();
            if (aligned == tiling.N) {
                AscendC::DataCopy(residentScale, x2ScaleGlobal, aligned);
            } else {
                AscendC::DataCopyExtParams copy = {
                    1, tiling.N * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
                AscendC::DataCopyPadExtParams<float> pad = {
                    true, 0, static_cast<uint8_t>(aligned - tiling.N), 0.0f};
                AscendC::DataCopyPad(residentScale, x2ScaleGlobal, copy, pad);
            }
            channelScaleQueue.EnQue(residentScale);
            residentScale = channelScaleQueue.DeQue<float>();
        }
        for (uint32_t row = firstRow; row < rowEnd; ++row) {
            ProcessRow(row);
        }
        if (QUANT_SCALE_RESIDENT && tiling.N <= VECTOR_TILE_N && firstRow < rowEnd) {
            channelScaleQueue.FreeTensor(residentScale);
        }
    }

private:
    __aicore__ inline void LoadAndActivate(uint32_t row, uint32_t column,
                                           uint32_t validCount, uint32_t alignedCount,
                                           float tokenScale)
    {
        const bool resident = QUANT_SCALE_RESIDENT && tiling.N <= VECTOR_TILE_N;
        AscendC::LocalTensor<float> channelScaleLocal = resident
            ? residentScale : channelScaleQueue.AllocTensor<float>();
        AscendC::LocalTensor<float> fpLocal = fpBuffer.Get<float>();

        const uint8_t rightPadding = static_cast<uint8_t>(alignedCount - validCount);
        if (floatMatmul) {
            AscendC::LocalTensor<float> mmFloatLocal = mmQueue.AllocTensor<float>();
            if (validCount == alignedCount) {
                AscendC::DataCopy(
                    mmFloatLocal,
                    mmFloatGlobal[static_cast<uint64_t>(row) * tiling.N + column],
                    alignedCount);
            } else {
                AscendC::DataCopyExtParams mmCopy = {
                    1, validCount * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
                AscendC::DataCopyPadExtParams<float> mmPad = {
                    true, 0, rightPadding, 0.0f};
                AscendC::DataCopyPad(
                    mmFloatLocal,
                    mmFloatGlobal[static_cast<uint64_t>(row) * tiling.N + column],
                    mmCopy, mmPad);
            }
            mmQueue.EnQue(mmFloatLocal);
            mmFloatLocal = mmQueue.DeQue<float>();
            AscendC::Adds(fpLocal, mmFloatLocal, 0.0f, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            mmQueue.FreeTensor(mmFloatLocal);
        } else {
            AscendC::LocalTensor<int32_t> mmLocal = mmQueue.AllocTensor<int32_t>();
            if (validCount == alignedCount) {
                // Prefer the aligned MTE path. DataCopyPad on dav-2201 may
                // fault even when no padding is requested.
                AscendC::DataCopy(
                    mmLocal,
                    mmGlobal[static_cast<uint64_t>(row) * tiling.N + column],
                    alignedCount);
            } else {
                AscendC::DataCopyExtParams mmCopy = {
                    1, validCount * static_cast<uint32_t>(sizeof(int32_t)), 0, 0, 0};
                AscendC::DataCopyPadExtParams<int32_t> mmPad = {
                    true, 0, rightPadding, 0};
                AscendC::DataCopyPad(
                    mmLocal,
                    mmGlobal[static_cast<uint64_t>(row) * tiling.N + column],
                    mmCopy, mmPad);
            }
            mmQueue.EnQue(mmLocal);
            mmLocal = mmQueue.DeQue<int32_t>();
            AscendC::Cast(fpLocal, mmLocal, AscendC::RoundMode::CAST_NONE,
                          alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            mmQueue.FreeTensor(mmLocal);
        }

        if (resident) {
            // Channel scales are immutable and already resident for this core.
        } else if (validCount == alignedCount) {
            AscendC::DataCopy(channelScaleLocal, x2ScaleGlobal[column], alignedCount);
        } else {
            AscendC::DataCopyExtParams scaleCopy = {
                1, validCount * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> scalePad = {
                true, 0, rightPadding, 0.0f};
            AscendC::DataCopyPad(
                channelScaleLocal, x2ScaleGlobal[column], scaleCopy, scalePad);
        }
        if (!resident) {
            channelScaleQueue.EnQue(channelScaleLocal);
            channelScaleLocal = channelScaleQueue.DeQue<float>();
        }
        AscendC::Muls(fpLocal, fpLocal, tokenScale, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(fpLocal, fpLocal, channelScaleLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(fpLocal, fpLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();
        if (!resident) {
            channelScaleQueue.FreeTensor(channelScaleLocal);
        }
    }

    __aicore__ inline float FindRowMax(uint32_t row, float tokenScale)
    {
        AscendC::LocalTensor<float> fpLocal = fpBuffer.Get<float>();
        AscendC::LocalTensor<float> reduceWorkLocal = reduceWorkBuffer.Get<float>();
        AscendC::LocalTensor<float> reduceOutLocal = reduceOutBuffer.Get<float>();
        float rowMax = 0.0f;

        for (uint32_t column = 0; column < tiling.N; column += VECTOR_TILE_N) {
            const uint32_t validCount =
                (tiling.N - column < VECTOR_TILE_N) ? (tiling.N - column) : VECTOR_TILE_N;
            const uint32_t alignedCount = AlignUpDevice(validCount, FLOAT_ALIGN_ELEMENTS);
            LoadAndActivate(row, column, validCount, alignedCount, tokenScale);
            AscendC::ReduceMax(reduceOutLocal, fpLocal, reduceWorkLocal,
                               static_cast<int32_t>(alignedCount), false);
            AscendC::PipeBarrier<PIPE_V>();
            const float tileMax = reduceOutLocal.GetValue(0);
            rowMax = tileMax > rowMax ? tileMax : rowMax;
#if QUANT_CACHE_TWO_TILES
            if (column == 0U && tiling.N > VECTOR_TILE_N && tiling.N <= 2U * VECTOR_TILE_N) {
                AscendC::Adds(firstTileBuffer.Get<float>(), fpLocal, 0.0f, alignedCount);
                AscendC::PipeBarrier<PIPE_V>();
            }
#endif
        }
        return rowMax;
    }

    __aicore__ inline void QuantizeRow(uint32_t row, float tokenScale, float outputScale,
                                       bool isZeroRow)
    {
        AscendC::LocalTensor<float> fpLocal = fpBuffer.Get<float>();
        AscendC::LocalTensor<int16_t> quantInt16Local = quantInt16Buffer.Get<int16_t>();
        AscendC::LocalTensor<half> quantHalfLocal = quantHalfBuffer.Get<half>();
        auto approximateLocal = divisorBuffer.Get<float>();
        auto denominatorLocal = reduceWorkBuffer.Get<float>();
        // This quotient is only a hint: integer product/remainder checks in
        // FastExactQuant certify or repair it. Avoid reciprocal overflow for
        // tiny scales by retaining the original Div path there.
        const bool useReciprocal = outputScale > 1.0e-30f;
        const float reciprocal = useReciprocal ? 1.0f / outputScale : 0.0f;
        const bool useVectorHint = tiling.N > 16U;
        // Restrict reciprocal multiplication to normal scale/reciprocal.
        // CONDITIONAL certificate: with IEEE binary32 correctly-rounded
        // reciprocal/multiply and q<=128,
        // 1/1024 is larger than the combined division/multiply rounding error.
        // Tiny/non-finite scales retain the all-element integer path. Device
        // reciprocal accuracy is a separate validation obligation; see
        // optimization/STRUCTURAL_EXPERIMENTS.md before deployment.
        const bool useBoundaryMask = QUANT_MASK_FAST_PATH && useVectorHint &&
            outputScale >= 1.0e-20f && outputScale <= 1.0e20f;
        // A row has one denominator. Decode/normalize it once, rather than
        // repeating these branches and shifts for every positive element.
        union QuantBits { float f; uint32_t u; } scaleBits;
        scaleBits.f = outputScale;
        int32_t scaleExponent = static_cast<int32_t>((scaleBits.u >> 23) & 255U);
        uint32_t scaleMantissa = scaleBits.u & 0x7fffffU;
        if ((scaleBits.u & 0x80000000U) || scaleExponent == 255 ||
            (scaleBits.u & 0x7fffffffU) == 0U) {
            scaleMantissa = 0U;
        } else if (scaleExponent) {
            scaleMantissa |= 0x800000U;
        } else {
            scaleExponent = 1;
            while (scaleMantissa < 0x800000U) { scaleMantissa <<= 1; --scaleExponent; }
        }

        for (uint32_t column = 0; column < tiling.N; column += VECTOR_TILE_N) {
            const uint32_t validCount =
                (tiling.N - column < VECTOR_TILE_N) ? (tiling.N - column) : VECTOR_TILE_N;
            const uint32_t alignedCount = AlignUpDevice(validCount, FLOAT_ALIGN_ELEMENTS);
            // A single-tile row is still resident in fpBuffer after ReduceMax.
            // Do not repeat GM loads, casts, scaling and ReLU in that case.
            if (!isZeroRow && tiling.N > VECTOR_TILE_N) {
#if QUANT_CACHE_TWO_TILES
                if (tiling.N <= 2U * VECTOR_TILE_N && column == 0U) {
                    // Restore the saved first activation tile without a GM
                    // reload. The final tile is reloaded in column order.
                    AscendC::Adds(fpLocal, firstTileBuffer.Get<float>(), 0.0f, alignedCount);
                    AscendC::PipeBarrier<PIPE_V>();
                } else
#endif
                LoadAndActivate(row, column, validCount, alignedCount, tokenScale);
            }
            AscendC::LocalTensor<int8_t> quantLocal = quantQueue.AllocTensor<int8_t>();

            if (isZeroRow) {
                AscendC::Duplicate(quantInt16Local, static_cast<int16_t>(0), alignedCount);
            } else {
                if (useReciprocal) {
                    AscendC::Muls(approximateLocal, fpLocal, reciprocal, alignedCount);
                } else {
                    AscendC::Duplicate(denominatorLocal, outputScale, alignedCount);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Div(approximateLocal, fpLocal, denominatorLocal, alignedCount);
                }
                if (useVectorHint) {
                    // Convert approximate quotients to integer hints on the
                    // vector pipe. The exact correction accepts any hint, so
                    // even a saturated conversion cannot affect the answer.
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(quantInt16Local, approximateLocal,
                                  AscendC::RoundMode::CAST_FLOOR, alignedCount);
                }
                if (useBoundaryMask || QUANT_VECTOR_ONLY) {
                    if (!QUANT_VECTOR_ONLY) {
                        // Distance to floor(q)+0.5, NOT distance to an integer.
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Cast(denominatorLocal, quantInt16Local,
                                      AscendC::RoundMode::CAST_NONE, alignedCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Adds(denominatorLocal, denominatorLocal, 0.5f, alignedCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Sub(denominatorLocal, approximateLocal, denominatorLocal, alignedCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Abs(denominatorLocal, denominatorLocal, alignedCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Compares(boundaryMaskBuffer.Get<uint8_t>(), denominatorLocal,
                            0.0009765625f, AscendC::CMPMODE::LE, alignedCount);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(quantInt16Local, approximateLocal,
                                  AscendC::RoundMode::CAST_RINT, alignedCount);
                }
                const auto vsEvent = ::GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(vsEvent);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(vsEvent);
                // Padding lanes are never copied to GM. Avoid scalar work
                // for them (particularly important for narrow tail tiles).
                // Read one packed mask word per 32 lanes, not one activation
                // per lane. Only boundary candidates touch the scalar helper.
                if (useBoundaryMask) {
                    auto mask = boundaryMaskBuffer.Get<uint32_t>();
                    for (uint32_t base = 0; base < validCount; base += 32U) {
                        uint32_t bits = mask.GetValue(base / 32U);
                        for (uint32_t bit = 0; bits != 0U && bit < 32U; ++bit, bits >>= 1U) {
                            const uint32_t i = base + bit;
                            if ((bits & 1U) && i < validCount) {
                                QuantBits numerator;
                                numerator.f = fpLocal.GetValue(i);
                                const uint32_t hint = static_cast<uint32_t>(quantInt16Local.GetValue(i));
                                quantInt16Local.SetValue(i, static_cast<int16_t>(
                                    FastExactQuantPrepared(numerator.u, scaleMantissa, scaleExponent, hint)));
                            }
                        }
                    }
                } else if (!QUANT_VECTOR_ONLY) {
                for (uint32_t i = 0; i < validCount; ++i) {
                    uint32_t value = 0U;
                    const float activation = fpLocal.GetValue(i);
                    // ReLU zeros need neither a hint load nor integer
                    // significand/exponent decoding.
                    if (activation > 0.0f) {
                        QuantBits numerator;
                        numerator.f = activation;
                        uint32_t hint;
                        if (useVectorHint) {
                            hint = static_cast<uint32_t>(quantInt16Local.GetValue(i));
                        } else {
                            QuantBits hintBits;
                            hintBits.f = approximateLocal.GetValue(i);
                            hint = FastQuantHintBits(hintBits.u);
                        }
                        value = FastExactQuantPrepared(numerator.u, scaleMantissa,
                            scaleExponent, hint);
                    }
                    quantInt16Local.SetValue(i, static_cast<int16_t>(value));
                }
                }
                const auto svEvent = ::GetTPipePtr()->FetchEventID(AscendC::HardEvent::S_V);
                AscendC::SetFlag<AscendC::HardEvent::S_V>(svEvent);
                AscendC::WaitFlag<AscendC::HardEvent::S_V>(svEvent);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(quantHalfLocal, quantInt16Local,
                          AscendC::RoundMode::CAST_NONE, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(quantLocal, quantHalfLocal,
                          AscendC::RoundMode::CAST_NONE, alignedCount);

            quantQueue.EnQue(quantLocal);
            quantLocal = quantQueue.DeQue<int8_t>();
            // DataCopyPad performs an exact byte-count VECOUT -> GM transfer
            // and also supplies the required Vector-to-MTE pipeline event.
            // A scalar GetValue loop here can observe the VEC result before
            // the final Cast has completed.
            AscendC::DataCopyExtParams outputCopy = {
                1, validCount * static_cast<uint32_t>(sizeof(int8_t)), 0, 0, 0};
            AscendC::DataCopyPad(
                yGlobal[static_cast<uint64_t>(row) * tiling.N + column],
                quantLocal, outputCopy);
            quantQueue.FreeTensor(quantLocal);
        }
    }

    __aicore__ inline void ProcessRow(uint32_t row)
    {
        const float tokenScale = x1ScaleGlobal.GetValue(row);
        const float rowMax = FindRowMax(row, tokenScale);
        const float outputScale = rowMax > 0.0f ? rowMax / 127.0f : 1.0f;

        // Use a proper VECOUT -> MTE3 transfer for the scale as well.  Scalar
        // GM SetValue is not reliable when multiple AIV groups store offsets
        // beyond the first 256-byte region of this output.
        AscendC::LocalTensor<float> yScaleLocal = yScaleQueue.AllocTensor<float>();
        AscendC::Duplicate(yScaleLocal, outputScale, FLOAT_ALIGN_ELEMENTS);
        yScaleQueue.EnQue(yScaleLocal);
        yScaleLocal = yScaleQueue.DeQue<float>();
        AscendC::DataCopyExtParams scaleOutputCopy = {
            1, static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yScaleGlobal[row], yScaleLocal, scaleOutputCopy);
        yScaleQueue.FreeTensor(yScaleLocal);

        QuantizeRow(row, tokenScale, outputScale, rowMax == 0.0f);
    }

    CubeTiling tiling;
    bool floatMatmul = false;
    AscendC::GlobalTensor<int32_t> mmGlobal;
    AscendC::GlobalTensor<float> mmFloatGlobal;
    AscendC::GlobalTensor<float> x1ScaleGlobal;
    AscendC::GlobalTensor<float> x2ScaleGlobal;
    AscendC::GlobalTensor<int8_t> yGlobal;
    AscendC::GlobalTensor<float> yScaleGlobal;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> mmQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> channelScaleQueue;
    AscendC::LocalTensor<float> residentScale;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> fpBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> divisorBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> reduceWorkBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> reduceOutBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> quantInt16Buffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> quantHalfBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> boundaryMaskBuffer;
#if QUANT_CACHE_TWO_TILES
    AscendC::TBuf<AscendC::QuePosition::VECCALC> firstTileBuffer;
#endif
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> quantQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> yScaleQueue;
};

__global__ __aicore__ void quant_matmul_relu_quant_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR x1Scale, GM_ADDR x2Scale, GM_ADDR y,
    GM_ADDR yScale, __kfc_workspace__ GM_ADDR workspace, CubeTiling tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    AscendC::TPipe pipe;
    // __kfc_workspace__ is already adjusted past the system workspace by
    // the launch framework.
    const bool useFloatMatmul = tiling.Ka >= FP32_MATMUL_K_THRESHOLD;

    if (useFloatMatmul) {
        const uint64_t x1FloatBytes =
            static_cast<uint64_t>(tiling.M) * tiling.Ka * sizeof(float);
        const uint64_t x2FloatOffset = (x1FloatBytes + 511ULL) & ~511ULL;
        const uint64_t x2FloatBytes =
            static_cast<uint64_t>(tiling.N) * tiling.Kb * sizeof(float);
        const uint64_t mmFloatOffset =
            (x2FloatOffset + x2FloatBytes + 511ULL) & ~511ULL;
        GM_ADDR x1Float = workspace;
        GM_ADDR x2Float = workspace + x2FloatOffset;
        GM_ADDR mmFloat = workspace + mmFloatOffset;

#if defined(SPLIT_CORE_VEC)
        if ASCEND_IS_AIV {
            FloatInputConverter converter;
            converter.Init(x1, x2, x1Float, x2Float, tiling, &pipe);
            converter.Process();
            AscendC::WaitEvent(5);

            VectorStage vectorStage;
            vectorStage.Init(mmFloat, x1Scale, x2Scale, y, yScale, tiling,
                             &pipe, true);
            vectorStage.Process();
        }
#endif
#if defined(SPLIT_CORE_CUBE)
        if ASCEND_IS_AIC {
            FloatCubeStage cubeStage;
            cubeStage.Init(x1Float, x2Float, mmFloat, tiling, &pipe);
            cubeStage.Process();
        }
#endif
        return;
    }

    GM_ADDR mmWorkspace = workspace;

    CubeStage cubeStage;
    cubeStage.Init(x1, x2, mmWorkspace, tiling);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), cubeStage.matmul, &cubeStage.tiling);

    if ASCEND_IS_AIV {
        // In MIX mode the AIV is the Matmul client.  Synchronous IterateAll
        // returns only after the paired AIC has committed this core's full
        // int32 result to GM; Matmul owns the internal synchronization flags.
        cubeStage.Process();

        VectorStage vectorStage;
        vectorStage.Init(mmWorkspace, x1Scale, x2Scale, y, yScale, tiling, &pipe);
        vectorStage.Process();
    }
}

inline bool GenerateMatmulTiling(platform_ascendc::PlatformAscendC *platform,
                                 uint32_t M, uint32_t N, uint32_t K,
                                 uint32_t requestedCoreNum, uint32_t baseM,
                                 uint32_t baseN, bool useFloatMatmul,
                                 CubeTiling &tiling)
{
    using matmul_tiling::CubeFormat;
    using matmul_tiling::DataType;
    using matmul_tiling::MatrixTraverse;
    using matmul_tiling::TPosition;

    matmul_tiling::MultiCoreMatmulTiling tilingApi(*platform);
    tilingApi.SetDim(requestedCoreNum);
    if (useFloatMatmul) {
        tilingApi.SetAType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT, false);
        tilingApi.SetBType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT, true);
        tilingApi.SetCType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT);
    } else {
        tilingApi.SetAType(TPosition::GM, CubeFormat::ND, DataType::DT_INT8, false);
        tilingApi.SetBType(TPosition::GM, CubeFormat::ND, DataType::DT_INT8, true);
        tilingApi.SetCType(TPosition::GM, CubeFormat::ND, DataType::DT_INT32);
    }
    tilingApi.SetBias(false);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetTraverse(MatrixTraverse::FIRSTM);

    // Keep N complete on every cube core so the paired Vector stage can
    // reduce a whole row without cross-core communication.  baseM must not
    // exceed the 16-aligned single-core M extent; otherwise GetTiling rejects
    // shapes such as M=129 split over two cores.
    uint32_t singleCoreM = CeilDivHost(M, requestedCoreNum);
    const bool alignedParallel = M >= 1024U && K < FP32_MATMUL_K_THRESHOLD && requestedCoreNum > 1U;
    if (alignedParallel) singleCoreM = AlignUpHost(singleCoreM, 128U);
    if (tilingApi.SetSingleShape(singleCoreM, N, K) == -1 ||
        tilingApi.SetFixSplit(baseM, baseN, -1) == -1) {
        return false;
    }
    tilingApi.SetBufferSpace(-1, -1, -1);

    if (tilingApi.GetTiling(tiling) == -1) {
        return false;
    }
    // Reject changed ownership boundaries; caller retries the single-core path.
    if (alignedParallel &&
        (tiling.singleCoreM != singleCoreM ||
         tiling.usedCoreNum != CeilDivHost(M, singleCoreM) ||
         tiling.singleCoreN < N)) {
        return false;
    }
    tiling.stepM = 1;
    tiling.stepN = 1;
    return true;
}

} // namespace QuantMatmulReluQuant

extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR x1Scale,
    const TensorGroupInfo &info_x1Scale, GM_ADDR x2Scale,
    const TensorGroupInfo &info_x2Scale, GM_ADDR y,
    const TensorGroupInfo &info_y, GM_ADDR yScale,
    const TensorGroupInfo &info_yScale, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_x1Scale;
    (void)info_x2Scale;
    (void)info_y;
    (void)info_yScale;

    const uint32_t M = static_cast<uint32_t>(info_x1.tensors[0].shape[0]);
    const uint32_t K = static_cast<uint32_t>(info_x1.tensors[0].shape[1]);
    const uint32_t N = static_cast<uint32_t>(info_x2.tensors[0].shape[0]);

    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return;
    }

    // Split only M across cube cores. This avoids a global row-max reduction
    // and still exposes useful parallelism for prefill / batched-token cases.
    constexpr uint32_t targetRowsPerCore = 128U;
    const uint32_t mTileCount =
        QuantMatmulReluQuant::CeilDivHost(M, targetRowsPerCore);
    const uint32_t hardwareCores =
        availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1U;
    // Correctness-first fallback for large-M cases.  Keeping the complete M
    // range on one client/core removes every cross-core ownership boundary
    // while retaining the proven multi-core path for the smaller cases.
    uint32_t requestedCores = M >= 1024U
        ? 1U
        : std::max(1U, std::min(hardwareCores, mTileCount));
    // Keep the separately synchronized FP32-conversion path unchanged.
    if (M >= 1024U && K < QuantMatmulReluQuant::FP32_MATMUL_K_THRESHOLD) {
        requestedCores = std::max(1U, std::min(hardwareCores, mTileCount));
        // Alignment can reduce the number of nonempty partitions. SetDim
        // must describe those active partitions, not the original core cap.
        // Each nonterminal iteration strictly decreases requestedCores.
        while (requestedCores > 1U) {
            const uint32_t alignedRows = QuantMatmulReluQuant::AlignUpHost(
                QuantMatmulReluQuant::CeilDivHost(M, requestedCores), 128U);
            const uint32_t activeCores = QuantMatmulReluQuant::CeilDivHost(M, alignedRows);
            if (activeCores == requestedCores) break;
            requestedCores = activeCores;
        }
    }
    const uint32_t rowsPerCore =
        QuantMatmulReluQuant::CeilDivHost(M, requestedCores);
    const uint32_t baseM = std::min(
        targetRowsPerCore, QuantMatmulReluQuant::AlignUpHost(rowsPerCore, 16U));
    const uint32_t baseN =
        std::min(QUANT_BASE_N, QuantMatmulReluQuant::AlignUpHost(N, 16U));

    QuantMatmulReluQuant::CubeTiling tiling;
    const bool useFloatMatmul =
        K >= QuantMatmulReluQuant::FP32_MATMUL_K_THRESHOLD;
    if (!QuantMatmulReluQuant::GenerateMatmulTiling(
            platform, M, N, K, requestedCores, baseM, baseN, useFloatMatmul,
            tiling)) {
        if (M < 1024U || useFloatMatmul || requestedCores <= 1U ||
            !QuantMatmulReluQuant::GenerateMatmulTiling(
                platform, M, N, K, 1U, targetRowsPerCore, baseN, useFloatMatmul, tiling)) {
            return;
        }
    }

    const uint32_t blockDim = tiling.usedCoreNum;
    const uint64_t systemWorkspaceSize =
        static_cast<uint64_t>(platform->GetLibApiWorkSpaceSize());
    const uint64_t userWorkspaceOffset = (systemWorkspaceSize + 511ULL) & ~511ULL;
    uint64_t matrixWorkspaceSize =
        static_cast<uint64_t>(M) * N * sizeof(int32_t);
    if (useFloatMatmul) {
        const uint64_t x1FloatBytes =
            static_cast<uint64_t>(M) * K * sizeof(float);
        const uint64_t x2FloatOffset = (x1FloatBytes + 511ULL) & ~511ULL;
        const uint64_t x2FloatBytes =
            static_cast<uint64_t>(N) * K * sizeof(float);
        const uint64_t mmFloatOffset =
            (x2FloatOffset + x2FloatBytes + 511ULL) & ~511ULL;
        matrixWorkspaceSize =
            mmFloatOffset + static_cast<uint64_t>(M) * N * sizeof(float);
    }
    const uint64_t totalWorkspaceSize = userWorkspaceOffset + matrixWorkspaceSize;

    uint8_t *workspace = nullptr;
    aclError ret = aclrtMalloc(reinterpret_cast<void **>(&workspace),
                               static_cast<size_t>(totalWorkspaceSize),
                               ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != 0) {
        return;
    }

    QuantMatmulReluQuant::quant_matmul_relu_quant_custom<<<blockDim, nullptr, stream>>>(
        x1, x2, x1Scale, x2Scale, y, yScale, workspace, tiling);

    // The public runner does not own a persistent workspace. Synchronize here
    // so the temporary allocation remains valid through the device kernel.
    ret = aclrtSynchronizeStream(stream);
    (void)ret;
    aclrtFree(workspace);
}
