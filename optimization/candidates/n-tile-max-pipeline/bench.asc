#ifdef N_TILE_ONE_CORE
// Limit the benchmark only; do not alter production run_kernel dispatch.
#include "acl/acl.h"
static inline aclError NTileDeviceInfo(uint32_t device, aclrtDevAttr attr, int64_t *value)
{
    const aclError rc = aclrtGetDeviceInfo(device, attr, value);
    if (rc == 0 && attr == ACL_DEV_ATTR_CUBE_CORE_NUM) *value = 1;
    return rc;
}
#define aclrtGetDeviceInfo NTileDeviceInfo
#endif
#include "../wide-row-tile-cv/bench.asc"
