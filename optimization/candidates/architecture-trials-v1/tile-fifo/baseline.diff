+// Paired-core pipeline: slot-specific ready/free events prevent overwriting
+// any row while VectorStage is still doing its second scan or exact repair.
+__global__ __aicore__ void quant_row_ring(
+    GM_ADDR x1, GM_ADDR x2, GM_ADDR ring,
+    GM_ADDR x1Scale, GM_ADDR x2Scale, GM_ADDR y, GM_ADDR yScale,
+    CubeTiling tiling, uint32_t rowTile)
+{
+    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
+    AscendC::TPipe pipe;
+    const uint32_t block = AscendC::GetBlockIdx();
+    const uint32_t blocks = AscendC::GetBlockNum();
+    const uint32_t jobs = (tiling.M + rowTile - 1U) / rowTile;
+    const uint32_t localJobs = block < jobs ? (jobs - 1U - block) / blocks + 1U : 0U;
+    const uint64_t slotBytes = static_cast<uint64_t>(rowTile) * tiling.N * sizeof(int32_t);
+    GM_ADDR coreRing = ring + static_cast<uint64_t>(block) * 2U * slotBytes;
+    if ASCEND_IS_AIC {
+        using A = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
+        using B = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, true>;
+        using C = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
+        AscendC::MatmulImpl<A, B, C, C, MATMUL_CONFIG> mm;
+        AscendC::GlobalTensor<int8_t> a, b;
+        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1));
+        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2));
+        mm.Init(&tiling, &pipe);
+        mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
+        for (uint32_t i = 0; i < localJobs; ++i) {
+            const uint32_t slot = i % 2U;
+            if (i >= 2U) AscendC::CrossCoreWaitFlag(6U + slot);
+            const uint32_t first = (block + i * blocks) * rowTile;
+            const uint32_t rows = tiling.M - first < rowTile ? tiling.M - first : rowTile;
+            AscendC::GlobalTensor<int32_t> c;
+            c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(coreRing + slot * slotBytes));
+            // A ring slot owns complete rows, so the producer must cover every
+            // N tile before publishing it.  Make ownership explicit rather
+            // than relying on SetSingleShape to expand across the full N.
+            for (uint32_t column = 0; column < static_cast<uint32_t>(tiling.N);) {
+                const uint32_t tileN = tiling.N - column < tiling.singleCoreN
+                    ? tiling.N - column : tiling.singleCoreN;
+                for (uint32_t k = 0; k < static_cast<uint32_t>(tiling.Ka);) {
+                    const uint32_t chunk = tiling.Ka - k < SAFE_ACCUM_K ? tiling.Ka - k : SAFE_ACCUM_K;
+                    mm.SetSingleShape(rows, tileN, chunk);
+                    mm.SetTensorA(a[static_cast<uint64_t>(first) * tiling.Ka + k], false);
+                    mm.SetTensorB(b[static_cast<uint64_t>(column) * tiling.Kb + k], true);
+                    mm.template IterateAll<true>(
+                        c[column], k == 0U ? 0U : 1U);
+                    k += chunk;
+                }
+                column += tileN;
+            }
+            AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(4U + slot);
+        }
+        // Consume every outstanding acknowledgement before exiting the kernel.
+        for (uint32_t i = localJobs > 2U ? localJobs - 2U : 0U; i < localJobs; ++i)
+            AscendC::CrossCoreWaitFlag(6U + i % 2U);
+        mm.End();
+    }
+    if ASCEND_IS_AIV {
+        VectorStage stage;
+        stage.Init(coreRing, x1Scale, x2Scale, y, yScale, tiling, &pipe);
+        stage.BeginRows(0U, tiling.M);
+        for (uint32_t i = 0; i < localJobs; ++i) {
+            const uint32_t slot = i % 2U;
+            AscendC::CrossCoreWaitFlag(4U + slot);
+            const uint32_t first = (block + i * blocks) * rowTile;
+            const uint32_t end = first + rowTile < tiling.M ? first + rowTile : tiling.M;
+            stage.BindRing(coreRing + slot * slotBytes, first);
+            stage.ProcessRows(first, end);
+            // All reads must finish before a producer may recycle this slot.
+            AscendC::PipeBarrier<PIPE_ALL>();
+            AscendC::CrossCoreSetFlag<0x2, PIPE_MTE2>(6U + slot);
+        }
+        stage.EndRows(0U, tiling.M);
+    }
+}
