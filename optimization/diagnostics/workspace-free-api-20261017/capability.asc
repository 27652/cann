// Compile-only capability check; not a benchmark or a submission candidate.
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

#if defined(__NPU_ARCH__)
static_assert(__NPU_ARCH__ == 2201, "This diagnostic targets dav-2201 only");
#ifndef USE_WORKSPACE
#error "Expected C220 Matmul GM-workspace transport"
#endif
#ifdef USE_SSBUF
#error "Unexpected SSBUF path on dav-2201"
#endif
static_assert(
    !AscendC::Impl::Detail::MatmulFeatureTrait<CFG_NORM>::IsSupportL0CToUB(),
    "Re-audit GetTensorC: toolkit now advertises L0C-to-UB support");
#pragma message("workspace-free audit: dav-2201 USE_WORKSPACE; L0C-to-UB unsupported")
#endif

__global__ __aicore__ void workspace_free_capability_probe()
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
}
