#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"

struct TensorInfo { const int64_t *shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo *tensors; int64_t numTensors; };
#ifndef BENCH_KERNEL
#define BENCH_KERNEL "kernel.asc"
#endif
#include BENCH_KERNEL

#define CHECK(call) do { int err = (call); if (err) { \
    fprintf(stderr, "%s: %d\n", #call, err); return 1; } } while (0)

int main(int argc, char **argv)
{
    if (argc != 5) return 1;
    upperBoundMode = std::strtoul(argv[4], nullptr, 10);
    if (upperBoundMode > 4U) return 1;
    const int64_t m = std::atoll(argv[1]), n = std::atoll(argv[2]), k = std::atoll(argv[3]);
    if (m <= 0 || n <= 0 || k <= 0) return 1;
    int64_t shapes[6][2] = {{m,k}, {n,k}, {m,0}, {n,0}, {m,n}, {m,0}};
    const int types[6] = {3,3,0,0,3,0};
    const size_t sizes[6] = {size_t(m*k), size_t(n*k), size_t(m*4), size_t(n*4),
                             size_t(m*n), size_t(m*4)};
    const char *files[6] = {"x1", "x2", "x1Scale", "x2Scale", "y", "yScale"};
    TensorInfo tensors[6];
    TensorGroupInfo groups[6];
    uint8_t *device[6] = {};
    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtStream stream;
    CHECK(aclrtCreateStream(&stream));
    int64_t cores;
    CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores));
    for (int i = 0; i < 6; ++i) {
        tensors[i] = {shapes[i], (i == 0 || i == 1 || i == 4) ? 2 : 1, types[i]};
        groups[i] = {&tensors[i], 1};
        CHECK(aclrtMalloc(reinterpret_cast<void **>(&device[i]), sizes[i], ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK(aclrtMemset(device[i], sizes[i], 0, sizes[i]));
        if (i < 4) {
            std::vector<uint8_t> host(sizes[i]);
            char path[128];
            std::snprintf(path, sizeof(path), "input/%s.bin", files[i]);
            FILE *f = std::fopen(path, "rb");
            if (!f || std::fread(host.data(), 1, sizes[i], f) != sizes[i]) return 2;
            std::fclose(f);
            CHECK(aclrtMemcpy(device[i], sizes[i], host.data(), sizes[i], ACL_MEMCPY_HOST_TO_DEVICE));
        }
    }
    run_kernel(device[0], groups[0], device[1], groups[1], device[2], groups[2],
               device[3], groups[3], device[4], groups[4], device[5], groups[5], cores, stream);
    CHECK(aclrtSynchronizeStream(stream));
    for (int i = 4; i < 6; ++i) {
        std::vector<uint8_t> host(sizes[i]);
        CHECK(aclrtMemcpy(host.data(), sizes[i], device[i], sizes[i], ACL_MEMCPY_DEVICE_TO_HOST));
        char path[128];
        std::snprintf(path, sizeof(path), "output/%s.bin", files[i]);
        FILE *f = std::fopen(path, "wb");
        if (!f || std::fwrite(host.data(), 1, sizes[i], f) != sizes[i]) return 2;
        std::fclose(f);
    }
    for (auto p : device) CHECK(aclrtFree(p));
    CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0));
    CHECK(aclFinalize());
    return 0;
}
