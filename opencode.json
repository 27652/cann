{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "gitlabcann/cookie", "effect": "deny" },
    { "action": "read", "resource": "*/gitlabcann/cookie", "effect": "deny" },
    { "action": "read", "resource": "gitlabcann/userid.txt", "effect": "deny" },
    { "action": "read", "resource": "*/gitlabcann/userid.txt", "effect": "deny" },
    { "action": "read", "resource": "evidence/formal/raw/*", "effect": "deny" },
    { "action": "read", "resource": "*/evidence/formal/raw/*", "effect": "deny" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "op/kernel.asc", "effect": "deny" },
    { "action": "edit", "resource": "op/kernel_v2.asc", "effect": "deny" },
    { "action": "edit", "resource": "op/kernel_v3.asc", "effect": "deny" },
    { "action": "edit", "resource": "*/op/kernel.asc", "effect": "deny" },
    { "action": "edit", "resource": "*/op/kernel_v2.asc", "effect": "deny" },
    { "action": "edit", "resource": "*/op/kernel_v3.asc", "effect": "deny" },
    { "action": "edit", "resource": "gitlabcann/cookie", "effect": "deny" },
    { "action": "edit", "resource": "*/gitlabcann/cookie", "effect": "deny" },
    { "action": "edit", "resource": "gitlabcann/userid.txt", "effect": "deny" },
    { "action": "edit", "resource": "*/gitlabcann/userid.txt", "effect": "deny" },
    { "action": "edit", "resource": "evidence/formal/raw/*", "effect": "deny" },
    { "action": "edit", "resource": "*/evidence/formal/raw/*", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "*/AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "*/opencode.json", "effect": "ask" },

    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "./run.sh*", "effect": "ask" },
    { "action": "shell", "resource": "bash run.sh*", "effect": "ask" },
    { "action": "shell", "resource": "sh run.sh*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}
