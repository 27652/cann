{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "gitlabcann/cookie": "deny",
      "*/gitlabcann/cookie": "deny"
    },
    "edit": {
      "*": "allow",
      "op/kernel.asc": "deny",
      "op/kernel_v2.asc": "deny",
      "op/kernel_v3.asc": "deny",
      "*/op/kernel.asc": "deny",
      "*/op/kernel_v2.asc": "deny",
      "*/op/kernel_v3.asc": "deny",
      "gitlabcann/cookie": "deny",
      "*/gitlabcann/cookie": "deny",
      "AGENTS.md": "ask",
      "*/AGENTS.md": "ask",
      "opencode.json": "ask",
      "*/opencode.json": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git clean *": "deny",
      "git reset --hard*": "deny",
      "git push*": "deny",
      "git commit*": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "./run.sh*": "ask",
      "bash run.sh*": "ask",
      "sh run.sh*": "ask",
      "sudo *": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}

